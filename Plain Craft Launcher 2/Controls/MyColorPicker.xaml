<Grid x:Class="PCL.MyColorPicker"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PCL"
      x:Name="PanBack" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <!-- 饱和度 / 明度 调色板 -->
    <Border x:Name="PanSv" Grid.Column="0" Width="140" Height="88" CornerRadius="4" ClipToBounds="True"
            BorderThickness="1" BorderBrush="{DynamicResource ColorBrushGray6}" Background="#00000000"
            MouseLeftButtonDown="PanSv_MouseDown" MouseMove="PanSv_MouseMove"
            MouseLeftButtonUp="PanSv_MouseUp" LostMouseCapture="PanSv_MouseUp">
        <Canvas x:Name="CanvasSv" ClipToBounds="True">
            <!-- 底层：当前色相的纯色，上叠白→透明（横向）与透明→黑（纵向）两层 -->
            <Rectangle x:Name="RectHue" Width="140" Height="88" Canvas.Left="0" Canvas.Top="0" />
            <Rectangle Width="140" Height="88" Canvas.Left="0" Canvas.Top="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="140" Height="88" Canvas.Left="0" Canvas.Top="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- 当前取值的光标 -->
            <Ellipse x:Name="ShapeCursor" Width="11" Height="11" Stroke="White" StrokeThickness="2"
                     Fill="#00000000" IsHitTestVisible="False" Canvas.Left="-5.5" Canvas.Top="-5.5" />
        </Canvas>
    </Border>
    <!-- 色相条 -->
    <Border x:Name="PanHue" Grid.Column="1" Width="13" Height="88" Margin="8,0,0,0" CornerRadius="4"
            ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource ColorBrushGray6}"
            Background="#00000000" MouseLeftButtonDown="PanHue_MouseDown" MouseMove="PanHue_MouseMove"
            MouseLeftButtonUp="PanHue_MouseUp" LostMouseCapture="PanHue_MouseUp">
        <Grid>
            <Rectangle>
                <Rectangle.Fill>
                    <!-- 七段色相彩虹，纵向排列 -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFF0000" Offset="0" />
                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                        <GradientStop Color="#FFFF0000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="ShapeHueMark" Height="3" Fill="White" VerticalAlignment="Top"
                       IsHitTestVisible="False" Margin="-1,0" />
        </Grid>
    </Border>
    <!-- 十六进制输入 -->
    <local:MyTextBox Grid.Column="2" x:Name="TextHex" Width="84" Height="28" Margin="10,0,0,0"
                     MaxLines="1" AcceptsReturn="False" VerticalAlignment="Top" />
</Grid>
