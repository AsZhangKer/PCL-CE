<local:MyPageRight x:Class="PCL.PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Launch.Home.Instances}" x:Name="PanInstanceListCard">
                <StackPanel x:Name="PanInstanceRoot" Margin="20,38,20,16">
                    <!-- 搜索框 + 添加文件夹（下载入口在标题栏的「下载」标签页） -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextSearchInstance" Grid.Column="0" Height="30" MaxLines="1"
                                         AcceptsReturn="False" VerticalContentAlignment="Center"
                                         HintText="{DynamicResource Launch.Home.Search.Hint}"
                                         ValidatedTextChanged="TextSearchInstance_TextChanged" />
                        <local:MyIconButton x:Name="BtnAddFolder" Grid.Column="1" Height="30" Width="30" Margin="8,0,0,0"
                                            SvgIcon="lucide/folder-plus" LogoScale="0.82"
                                            ToolTip="{DynamicResource Launch.Home.Folder.Add}"
                                            Click="BtnAddFolder_Click" />
                    </Grid>
                    <!-- 多选工具条（长按实例进入） -->
                    <Grid x:Name="PanMultiSelect" Visibility="Collapsed" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabMultiSelect" VerticalAlignment="Center" FontSize="12.5" Opacity="0.7" />
                        <local:MyButton Grid.Column="1" x:Name="BtnMultiDelete" Height="28" Padding="12,0"
                                        ColorType="Red" Text="{DynamicResource Launch.Home.MultiSelect.Delete}"
                                        Click="BtnMultiDelete_Click" />
                        <local:MyButton Grid.Column="2" x:Name="BtnMultiCancel" Height="28" Margin="8,0,0,0"
                                        Padding="12,0" Text="{DynamicResource Common.Action.Cancel}"
                                        Click="BtnMultiCancel_Click" />
                    </Grid>
                    <!-- 按文件夹分组的实例列表 -->
                    <StackPanel x:Name="StackInstanceList" />
                    <TextBlock x:Name="LabInstanceEmpty" Visibility="Collapsed" FontSize="12.5" Opacity="0.6"
                               Margin="2,8,0,4" Text="{DynamicResource Launch.Home.Instance.Empty}" />
                </StackPanel>
            </local:MyCard>
            <StackPanel x:Name="PanCustom" />
            <!-- 社区版公告提示已移除 -->
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.Log.Title}" x:Name="PanLog">
                <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextTrimming="None" TextWrapping="Wrap" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>