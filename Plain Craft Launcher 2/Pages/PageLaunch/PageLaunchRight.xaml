<local:MyPageRight x:Class="PCL.PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <!-- 四周统一留白：实例卡片不再贴住窗口右边缘与下边缘，卡片内部自行滚动 -->
    <Grid Margin="25,25,25,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 实例卡片：填满剩余高度，列表在卡片内部滚动，因此卡片四边始终可见 -->
        <local:MyCard Grid.Row="0" Title="{DynamicResource Launch.Home.Instances}" x:Name="PanInstanceListCard">
            <Grid x:Name="PanInstanceRoot" Margin="20,38,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 搜索框 + 添加文件夹（下载入口在标题栏的「下载」标签页） -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:MyTextBox x:Name="TextSearchInstance" Grid.Column="0" Height="30" MaxLines="1"
                                     AcceptsReturn="False" VerticalContentAlignment="Center"
                                     HintText="{DynamicResource Launch.Home.Search.Hint}"
                                     ValidatedTextChanged="TextSearchInstance_TextChanged" />
                    <local:MyIconButton x:Name="BtnAddFolder" Grid.Column="1" Height="30" Width="30" Margin="8,0,0,0"
                                        SvgIcon="lucide/folder-plus" LogoScale="0.82"
                                        ToolTip="{DynamicResource Launch.Home.Folder.Add}"
                                        Click="BtnAddFolder_Click" />
                </Grid>
                <!-- 多选工具条（长按实例进入） -->
                <Grid x:Name="PanMultiSelect" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LabMultiSelect" VerticalAlignment="Center" FontSize="12.5" Opacity="0.7" />
                    <local:MyButton Grid.Column="1" x:Name="BtnMultiDelete" Height="28" Padding="12,0"
                                    ColorType="Red" Text="{DynamicResource Launch.Home.MultiSelect.Delete}"
                                    Click="BtnMultiDelete_Click" />
                    <local:MyButton Grid.Column="2" x:Name="BtnMultiCancel" Height="28" Margin="8,0,0,0"
                                    Padding="12,0" Text="{DynamicResource Common.Action.Cancel}"
                                    Click="BtnMultiCancel_Click" />
                </Grid>
                <!-- 列表本体：独立滚动，避免把整张卡片顶出窗口 -->
                <local:MyScrollViewer Grid.Row="2" x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" DeltaMult="0.7">
                    <StackPanel x:Name="StackInstanceList" Margin="0,0,4,0" />
                </local:MyScrollViewer>
                <TextBlock Grid.Row="3" x:Name="LabInstanceEmpty" Visibility="Collapsed" FontSize="12.5"
                           Opacity="0.6" Margin="2,8,0,4" Text="{DynamicResource Launch.Home.Instance.Empty}" />
            </Grid>
        </local:MyCard>
        <!-- 自定义主页内容与日志卡片置于卡片下方 -->
        <StackPanel Grid.Row="1">
            <StackPanel x:Name="PanCustom" />
            <local:MyCard Margin="0,15,0,0" Title="{DynamicResource Launch.Right.Log.Title}" x:Name="PanLog"
                          MaxHeight="150">
                <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </local:MyCard>
        </StackPanel>
    </Grid>
</local:MyPageRight>
